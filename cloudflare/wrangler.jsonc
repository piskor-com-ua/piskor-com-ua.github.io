{
  "name": "piskor-markdown",
  "main": "../output/markdown-worker/worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "vars": {
    "HTML_PRECOMPRESSED_DISABLED": "true"
  },
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1782407601",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ]
}

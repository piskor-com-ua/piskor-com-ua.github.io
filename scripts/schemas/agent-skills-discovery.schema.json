{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:piskor:schemas:agent-skills-discovery:0.2.0",
  "$comment": "Local validation implementation of the pinned draft RFC; not an upstream-published JSON Schema. See README.md for provenance.",
  "type": "object",
  "required": ["$schema", "skills"],
  "properties": {
    "$schema": {"const": "https://schemas.agentskills.io/discovery/0.2.0/schema.json"},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "description", "url", "digest"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "type": {"enum": ["skill-md", "archive"]},
          "description": {"type": "string", "minLength": 1, "maxLength": 1024},
          "url": {"type": "string", "minLength": 1, "format": "uri-reference"},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    }
  }
}
